# Token fino de GitHub: solo el repositorio drcacademycourses/drc-respond, permiso Contents (lectura y escritura).
GITHUB_TOKEN=
# Claves de acceso a la app. Quien entra con CLAVE_MANDOS puede cambiar el panel; con CLAVE_VISTA solo mira.
CLAVE_MANDOS=
CLAVE_VISTA=
# Opcional: token de la Developer API de Respond, para marcar como venta a los contactos que hoy son Alumno.
RESPONDIO_TOKEN=
# Opcionales (valores por defecto)
REPO_BOT=drcacademycourses/drc-respond
RAMA_ESTADO=estado
